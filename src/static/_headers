# Cloudflare Pages applies EVERY matching rule, and a browser enforces each
# Content-Security-Policy header independently — the effective policy is the
# intersection. The /* policy below must therefore permit everything /admin/*
# needs (GitHub API, blob: previews, same-origin frames); the stricter /admin/*
# policy then narrows it back down for the CMS only.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://asset-tidycal.b-cdn.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src 'self' https://tidycal.com https://*.tidycal.com; connect-src 'self' https://api.github.com https://tidycal.com https://*.tidycal.com; base-uri 'self'; form-action 'self' https://tidycal.com; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com; frame-src 'self'; base-uri 'self'; object-src 'none'

/assets/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/admin/sveltia-cms.js
  Cache-Control: public, max-age=86400

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600
